; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="unrelated vibe game"
run/main_scene="uid://tt1bmibibnsq"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://assets/icon.svg"

[display]

window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[editor_plugins]

enabled=PackedStringArray("res://addons/gdUnit4/plugin.cfg")

[file_customization]

folder_colors={
"res://assets/": "purple",
"res://game/": "blue",
"res://system/": "orange",
"res://ui/": "green"
}

[gdunit4]

settings/common/update_notification_enabled=false
settings/test/test_lookup_folder="tests"
settings/test/test_timeout_seconds=60
report/godot/push_error=true
report/godot/script_error=true
report/verbose_orphans=true

[physics]

3d/physics_engine="Jolt Physics"

[rendering]

rendering_device/driver.windows="d3d12"
